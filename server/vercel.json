{
  "version": 2,
  "regions": ["sin1"],
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin.webmanifest", "has": [{ "type": "host", "value": "api.viewsofvgm.com" }], "destination": "/admin-production.webmanifest" },
    { "source": "/admin.webmanifest", "destination": "/admin-staging.webmanifest" }
  ],
  "crons": [
    { "path": "/api/cron-news?market=in", "schedule": "0 3 * * *" },
    { "path": "/api/cron-news?market=us", "schedule": "0 13 * * *" }
  ],
  "headers": [
    { "source": "/admin-sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Service-Worker-Allowed", "value": "/" }] },
    { "source": "/(admin-staging|admin-production).webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }, { "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
