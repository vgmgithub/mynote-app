# Razorpay keys. These are read by the SERVER (server/lib/razorpay.js) from its environment.
#
# Do NOT put real values in this file or commit them. Set them in the Vercel dashboard instead:
#   the STAGING server project   -> Environment Variables -> your rzp_test_ pair
#   the PRODUCTION server project -> not until purchases go live, and then the rzp_live_ pair
#
# The key SECRET must never reach the browser. The public key id is returned to the app by /api/create-order,
# so nothing needs a NEXT_PUBLIC_ / VITE_ / REACT_APP_ copy: this project has no build step.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
